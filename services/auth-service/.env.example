# Spring Configuration
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
POSTGRES_USER=globalbooking
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

DB_NAME=auth_service
DB_USERNAME=globalbooking
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_256BIT_SECRET

# Token Expiration (milliseconds)
ACCESS_TOKEN_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000

# CORS Configuration
# Example: https://booking.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://booking.example.com