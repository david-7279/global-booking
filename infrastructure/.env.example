# =========================================================
# Spring Configuration
# =========================================================

SPRING_PROFILES_ACTIVE=prod

# =========================================================
# PostgreSQL Configuration
# =========================================================

POSTGRES_USER=globalbooking
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

DB_NAME=auth_service
DB_USERNAME=globalbooking
DB_PASSWORD=SAME_PASSWORD_AS_POSTGRES_PASSWORD

# HikariCP connection pool
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# =========================================================
# JWT Configuration
# =========================================================

# Generate with:
# openssl rand -base64 32
#
# Must be a Base64-encoded secret with at least 256 bits.
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_256BIT_SECRET
# Identifies the service that issues the JWT.
JWT_ISSUER=global-booking-auth-service
# Identifies the intended consumer of the JWT.
JWT_AUDIENCE=global-booking-api

# =========================================================
# Token Expiration
# =========================================================

# Access token lifetime: 15 minutes
ACCESS_TOKEN_EXPIRATION=900000
# Refresh token lifetime: 7 days
REFRESH_TOKEN_EXPIRATION=604800000

# =========================================================
# CORS Configuration
# =========================================================

# Comma-separated list of allowed origins.
# Example:
# CORS_ALLOWED_ORIGINS=https://booking.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://booking.example.com

# =========================================================
# RabbitMQ Configuration
# =========================================================

RABBITMQ_USER=broker-globalbooking
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=global-booking
# Host ports used only by the development Compose.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =========================================================
# Outbox Configuration
# =========================================================
OUTBOX_PUBLISH_DELAY_MS=1000
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_CONFIRM_TIMEOUT_MS=5000
# Retry delays: 5 seconds, 30 seconds, 5 minutes
OUTBOX_RETRY_DELAYS_MS=5000,30000,300000

# =========================================================
# Business Service Configuration
# =========================================================
BUSINESS_DB_NAME=business_service
BUSINESS_DB_USERNAME=globalbooking
BUSINESS_DB_PASSWORD=SAME_PASSWORD_AS_POSTGRES_PASSWORD

BUSINESS_SERVICE_PORT=8082
BUSINESS_SERVICE_URL=http://business-service:8080
BUSINESS_EVENT_RETRY_MAX_ATTEMPTS=3
BUSINESS_EVENT_RETRY_INITIAL_INTERVAL_MS=1000
BUSINESS_EVENT_RETRY_MULTIPLIER=2.0
BUSINESS_EVENT_RETRY_MAX_INTERVAL_MS=10000

# =========================================================
# Booking Service Configuration
# =========================================================
BOOKING_DB_NAME=booking_service
BOOKING_DB_USERNAME=globalbooking
BOOKING_DB_PASSWORD=SAME_PASSWORD_AS_POSTGRES_PASSWORD
BOOKING_SERVICE_PORT=8082
BUSINESS_CONNECT_TIMEOUT_MS=2000
BUSINESS_READ_TIMEOUT_MS=3000
BOOKING_OUTBOX_DELAY_MS=1000
BOOKING_OUTBOX_MAX_ATTEMPTS=3
BOOKING_OUTBOX_INITIAL_BACKOFF_MS=1000
BOOKING_OUTBOX_MAX_BACKOFF_MS=10000

# =========================================================
# Notification Service Configuration
# =========================================================
NOTIFICATION_DB_NAME=notification_service
NOTIFICATION_DB_USERNAME=globalbooking
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_PREFETCH=10
# Retry delays of consumed events: 5 seconds, 30 seconds, 5 minutes
NOTIFICATION_RETRY_DELAYS_MS=5000,30000,300000
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_DISPATCH_DELAY_MS=2000
NOTIFICATION_DISPATCH_BATCH_SIZE=50
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
NOTIFICATION_DELIVERY_INITIAL_BACKOFF_MS=5000
NOTIFICATION_DELIVERY_MAX_BACKOFF_MS=300000
NOTIFICATION_INTERRUPTED_DELIVERY_THRESHOLD_MS=600000
NOTIFICATION_DEFAULT_LOCALE=en

# =========================================================
# Email Configuration
# =========================================================
# When MAIL_ENABLED=false the service logs the email instead of using SMTP.
# The development Compose starts Mailpit and enables SMTP automatically.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
MAIL_FROM=no-reply@global-booking.local
MAIL_FROM_NAME=Global Booking
MAIL_SUBJECT_PREFIX=[Global Booking]

# =========================================================
# Frontend Configuration
# =========================================================

# Base path used by the SPA to call the API through the gateway.
# Build-time only: it is embedded in the JS bundle, so changing it requires a rebuild.
VITE_API_BASE_URL=/api

# Porta pública do Vite em modo desenvolvimento.
FRONTEND_PORT=5173

# Destino interno do proxy Vite dentro da rede Docker.
VITE_DEV_API_PROXY_TARGET=http://api-gateway:8080

# Host port of the api-gateway. The application is served at http://localhost:${GATEWAY_PORT}
GATEWAY_PORT=3000