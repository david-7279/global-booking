# =========================================================
# Spring Configuration
# =========================================================

SPRING_PROFILES_ACTIVE=prod

# =========================================================
# PostgreSQL Configuration
# =========================================================

POSTGRES_USER=globalbooking
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

DB_NAME=auth_service
DB_USERNAME=globalbooking
DB_PASSWORD=SAME_PASSWORD_AS_POSTGRES_PASSWORD

# HikariCP connection pool
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# =========================================================
# JWT Configuration
# =========================================================

# Generate with:
# openssl rand -base64 32
#
# Must be a Base64-encoded secret with at least 256 bits.
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_256BIT_SECRET
# Identifies the service that issues the JWT.
JWT_ISSUER=global-booking-auth-service
# Identifies the intended consumer of the JWT.
JWT_AUDIENCE=global-booking-api

# =========================================================
# Token Expiration
# =========================================================

# Access token lifetime: 15 minutes
ACCESS_TOKEN_EXPIRATION=900000
# Refresh token lifetime: 7 days
REFRESH_TOKEN_EXPIRATION=604800000

# =========================================================
# CORS Configuration
# =========================================================

# Comma-separated list of allowed origins.
# Example:
# CORS_ALLOWED_ORIGINS=https://booking.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://booking.example.com

# =========================================================
# RabbitMQ Configuration
# =========================================================

RABBITMQ_USER=broker-globalbooking
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=global-booking
# Host ports used only by the development Compose.
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# =========================================================
# Outbox Configuration
# =========================================================
OUTBOX_PUBLISH_DELAY_MS=1000
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_CONFIRM_TIMEOUT_MS=5000
# Retry delays: 5 seconds, 30 seconds, 5 minutes
OUTBOX_RETRY_DELAYS_MS=5000,30000,300000

# =========================================================
# Business Service Configuration
# =========================================================
BUSINESS_DB_NAME=business_service
BUSINESS_DB_USERNAME=globalbooking
BUSINESS_DB_PASSWORD=SAME_PASSWORD_AS_POSTGRES_PASSWORD
BUSINESS_SERVICE_PORT=8081